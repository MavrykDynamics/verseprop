  "description": "",
  "devDependencies": {
    "@types/jest": "^28.1.8",
    "@types/mocha": "^9.1.1",
    "@types/node": "^20.3.1",
    "@types/yargs": "^17.0.10",
    "assert": "^2.0.0",
    "chai": "^4.3.6",
    "chai-as-promised": "^7.1.1",
    "chai-bignumber": "^3.0.0",
    "fs-extra": "^10.1.0",
    "lodash": "^4.17.21",
    "onchange": "^7.1.0",
    "promise-retry": "^2.0.1",
    "rimraf": "^3.0.2"
  },
  "scripts": {
    "pull-sandbox": "TAG=4.7.7 docker-compose -f docker-compose.yml pull",
    "start-sandbox": "TAG=4.7.7 docker-compose -f docker-compose.yml up -d && bash ./sandbox-init.sh",
    "start-sandbox-m1": "docker run --rm --platform=linux/arm64/v8 --name mavryk-sandbox -e block_time=3 --detach -p 8732:20000 oxheadalpha/flextesa:20230203 limabox start && bash ./sandbox-init.sh",
    "down-sandbox": "docker-compose -f docker-compose.yml down",
    "clear-sandbox": "docker-compose -f docker-compose.yml down -v",
    "restart-sandbox": "yarn clear-sandbox && yarn start-sandbox",
    "generate-error-codes": "bash ./generate-error-codes.sh",

    "compile": "./bash-compile-contracts.sh -c",
    "deploy": "bash ./bash-deploy-contracts.sh -c",
    "test": "bash ./bash-test-contracts.sh -c",
    
    "setup-debt-controller": "NODE_ENV=development NETWORK_TO_MIGRATE_TO=atlasnet PRODUCTION=true ts-mocha --paths test/interact/00_setup_debt_controller.spec.ts --bail --timeout 900000 --exit",
    "create-new-debt": "NODE_ENV=development NETWORK_TO_MIGRATE_TO=atlasnet PRODUCTION=true ts-mocha --paths test/interact/01_create_new_debt.spec.ts --bail --timeout 900000 --exit",
    "mint-debt-nft": "NODE_ENV=development NETWORK_TO_MIGRATE_TO=atlasnet PRODUCTION=true ts-mocha --paths test/interact/02_mint_debt_nft.spec.ts --bail --timeout 900000 --exit",
    "create-verse-token": "NODE_ENV=development ts-mocha --paths test/interact/03_create_verse_token.spec.ts --bail --timeout 900000 --exit",
    "mint-verse-token": "NODE_ENV=development ts-mocha --paths test/interact/04_mint_verse_token.spec.ts --bail --timeout 900000 --exit"

  },
  "author": "tim@mavrykdynamics.io",
  "license": "MIT",
  "dependencies": {
    "@mavrykdynamics/create-lambda-bytes": "^0.3.2-l1",
