  view "getDebt"
       nat
       (option
          (pair (nat %maxAmount)
                (nat %interestRate)
                (nat %term)
                (address %walletAddress)
                (nat %minInvestmentAmount)
                (nat %totalInvestment)
                (or %status (or (unit %fUNDED) (unit %oPEN)) (or (unit %sETTLED) (unit %uNFUNDED)))
                (nat %startDate)
                (nat %settledDate)
                (address %nftContractAddress)
                (bytes %tokenURI)
                (string %currency)))
       { UNPAIR ; SWAP ; GET 19 ; SWAP ; GET } ;
  view "calculateInterest"
       (pair nat nat)
       nat
       { UNPAIR ;
         SWAP ;
         GET 19 ;
         DUP 2 ;
         CAR ;
         GET ;
         IF_NONE
           { PUSH string "Debt with the provided id does not exist" ; FAILWITH }
           {} ;
         PUSH nat 0 ;
         DUP 2 ;
         GET 17 ;
         COMPARE ;
         EQ ;
         IF { DUP ; GET 15 ; LEVEL ; SUB } { DUP ; GET 15 ; DUP 2 ; GET 17 ; SUB } ;
         ABS ;
         PUSH nat 10000 ;
         DIG 2 ;
         GET 3 ;
         EDIV ;
         IF_NONE { PUSH string "DIV by 0" ; FAILWITH } {} ;
         CAR ;
         PUSH nat 86400 ;
         DUG 2 ;
         DIG 3 ;
         CDR ;
         MUL ;
         MUL ;
         EDIV ;
         IF_NONE { PUSH string "DIV by 0" ; FAILWITH } {} ;
         CAR } ;
  view "getLambdaOpt"
       string
       (option bytes)
       { UNPAIR ; SWAP ; GET 24 ; SWAP ; GET } }

