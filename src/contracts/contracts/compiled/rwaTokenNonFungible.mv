         GET ;
         IF_NONE { NONE (pair nat (map string bytes)) } { SOME } } ;
  view "getUserBalanceAtTimestamp"
       (pair (nat %tokenId)
             (address %user)
             (timestamp %timestamp)
             (option %startCounter nat)
             (option %endCounter nat))
       nat
       { UNPAIR ;
         DUP ;
         CAR ;
         DUP 2 ;
         GET 3 ;
         DUP 3 ;
         GET 5 ;
         DUP 5 ;
         GET 11 ;
         DUP 4 ;
         GET ;
         IF_NONE { PUSH nat 77 ; FAILWITH } { DROP } ;
         DUP 5 ;
         GET 15 ;
         DUP 3 ;
         GET ;
         IF_NONE { PUSH nat 0 ; PUSH nat 1 ; PAIR } {} ;
         CDR ;
         DUP 5 ;
         GET 7 ;
         IF_NONE
           { DIG 4 ; DROP 2 ; PUSH nat 1 }
           { DIG 5 ;
             GET 8 ;
             IF_NONE
               { SWAP }
               { DUP 3 ; DUP 2 ; COMPARE ; GT ; IF { DROP ; SWAP } { DIG 2 ; DROP } } ;
             DUP 2 ;
             COMPARE ;
             LT ;
             IF {} { DROP ; PUSH nat 83 ; FAILWITH } } ;
         PUSH bool True ;
         PUSH bool False ;
         DUP 3 ;
         PUSH nat 1 ;
         PUSH nat 1000 ;
         DIG 5 ;
         EDIV ;
         IF_NONE { PUSH string "DIV by 0" ; FAILWITH } {} ;
         CAR ;
         ADD ;
         PUSH nat 0 ;
         PUSH nat 0 ;
         PUSH bool True ;
         LOOP { PUSH bool True ;
                DUP 7 ;
                COMPARE ;
                EQ ;
                DUP ;
                IF { DUP 4 ;
                     DUP 10 ;
                     DUP 12 ;
                     PAIR ;
                     PAIR ;
                     DUP 12 ;
                     GET 17 ;
                     SWAP ;
                     GET ;
                     IF_NONE { EMPTY_MAP nat (pair nat timestamp) } {} ;
                     DUP 6 ;
                     GET ;
                     IF_NONE
                       { DIG 6 ; DROP ; PUSH bool False ; DUG 6 }
                       { DIG 2 ;
                         DROP ;
                         DUP 8 ;
                         DUP 2 ;
                         CDR ;
                         SUB ;
                         PUSH int 0 ;
                         SWAP ;
                         COMPARE ;
                         GT ;
                         DUP 8 ;
                         AND ;
                         IF { DIG 6 ; DROP ; PUSH bool False ; DUG 6 }
                            { DIG 2 ;
                              DIG 3 ;
                              DROP 2 ;
                              DUP ;
                              CAR ;
                              DUG 2 ;
                              PUSH nat 1 ;
                              DIG 4 ;
                              ADD ;
                              DUG 3 ;
                              PUSH nat 1 ;
                              PUSH nat 1000 ;
                              DUP 6 ;
                              EDIV ;
                              IF_NONE { PUSH string "DIV by 0" ; FAILWITH } {} ;
                              CAR ;
                              ADD ;
                              DUG 3 } ;
                         DUP 3 ;
                         DUG 2 ;
                         PUSH nat 1 ;
                         DUP 7 ;
                         COMPARE ;
                         EQ ;
                         DUP 10 ;
                         DUP 3 ;
                         CDR ;
                         COMPARE ;
                         GT ;
                         AND ;
                         IF { DIG 2 ;
                              DIG 6 ;
                              DIG 7 ;
                              DROP 3 ;
                              PUSH bool True ;
                              DUG 5 ;
                              PUSH bool False ;
                              DUG 6 ;
                              PUSH nat 0 ;
                              DUG 2 }
                            {} ;
                         PUSH bool False ;
                         DUP 8 ;
                         COMPARE ;
                         EQ ;
                         IF { DIG 6 ;
                              DROP ;
                              DUP 8 ;
                              SWAP ;
                              CDR ;
                              COMPARE ;
                              GT ;
                              IF { PUSH nat 84 ; FAILWITH } {} ;
                              PUSH bool True ;
                              DUG 5 }
                            { DROP } } }
                   {} } ;
         SWAP ;
         DIG 2 ;
         DIG 3 ;
         DIG 4 ;
         DIG 5 ;
         DIG 6 ;
         DIG 7 ;
         DIG 8 ;
         DIG 9 ;
         DROP 9 } ;
  view "getUserSnapshots"
       (pair (nat %tokenId)
             (address %user)
             (option %startCounter nat)
             (option %endCounter nat))
       (list (pair nat timestamp))
       { UNPAIR ;
         DUP ;
         CAR ;
         DUP 2 ;
         GET 3 ;
         DUP 4 ;
         GET 11 ;
         DUP 3 ;
         GET ;
         IF_NONE { PUSH nat 77 ; FAILWITH } { DROP } ;
         DUP 4 ;
         GET 15 ;
         DUP 2 ;
         GET ;
         IF_NONE { PUSH nat 0 ; PUSH nat 1 ; PAIR } {} ;
         CDR ;
         DUP 4 ;
         GET 6 ;
         IF_NONE
           {}
           { DUP 2 ; DUP 2 ; COMPARE ; GT ; IF { DROP } { SWAP ; DROP } } ;
         DIG 3 ;
         GET 5 ;
         IF_NONE
           { PUSH nat 1 }
           { DUP 2 ;
             DUP 2 ;
             COMPARE ;
             LT ;
             IF {} { DROP ; PUSH nat 83 ; FAILWITH } } ;
         PUSH bool True ;
         DUP 2 ;
         PUSH nat 1 ;
         PUSH nat 1000 ;
         DIG 4 ;
         EDIV ;
         IF_NONE { PUSH string "DIV by 0" ; FAILWITH } {} ;
         CAR ;
         ADD ;
         NIL (pair nat timestamp) ;
         PUSH bool True ;
         LOOP { PUSH bool True ;
                DUP 5 ;
                COMPARE ;
                EQ ;
                DUP ;
                IF { PUSH nat 1 ;
                     DUP 7 ;
                     ADD ;
                     DUP 5 ;
                     COMPARE ;
                     EQ ;
                     IF { DIG 4 ; DROP ; PUSH bool False ; DUG 4 }
                        { DIG 2 ;
                          DUP 7 ;
                          DUP 9 ;
                          PAIR ;
                          PAIR ;
                          DUP 9 ;
                          GET 17 ;
                          SWAP ;
                          GET ;
                          IF_NONE { EMPTY_MAP nat (pair nat timestamp) } {} ;
                          DUP 4 ;
                          GET ;
                          IF_NONE
                            { DIG 3 ; DROP ; PUSH bool False ; DUG 3 ; SWAP }
                            { DIG 2 ; SWAP ; CONS } ;
                          SWAP ;
                          PUSH nat 1 ;
                          DIG 3 ;
                          ADD ;
                          DUG 2 ;
                          PUSH nat 1 ;
                          PUSH nat 1000 ;
                          DUP 5 ;
                          EDIV ;
                          IF_NONE { PUSH string "DIV by 0" ; FAILWITH } {} ;
                          CAR ;
                          ADD ;
                          DUG 2 } }
                   {} } ;
         SWAP ;
         DIG 2 ;
         DIG 3 ;
         DIG 4 ;
         DIG 5 ;
         DIG 6 ;
         DIG 7 ;
         DROP 7 } }

