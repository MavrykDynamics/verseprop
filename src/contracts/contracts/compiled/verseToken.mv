{ parameter
    (or (or (or (nat %burn) (address %mint))
            (or (pair %reissue (address %_to) (nat %tokenId) (bytes %tokenURI))
                (address %setAdmin)))
        (pair %updateWhitelistContracts
           (string %whitelistContractName)
           (address %whitelistContractAddress)
           (or %updateType (unit %remove) (unit %update)))) ;
  storage
    (pair (address %admin)
          (big_map %metadata string bytes)
          (nat %_maxSupply)
          (nat %_percentageInterest)
          (string %_description)
          (string %_location)
          (string %_value)
          (string %_other)
          (bytes %_baseTokenURI)
          (map %whitelistContracts string address)
          (big_map %token_metadata nat (pair (nat %token_id) (map %token_info string bytes)))
          (big_map %total_supply nat nat)
          (big_map %ledger (pair (address %owner) (nat %token_id)) nat)
          (big_map %ownerLedger nat address)
          (nat %nextTokenId)) ;
  code { NIL operation ;
         LAMBDA
           (pair address
                 (big_map string bytes)
                 nat
                 nat
                 string
                 string
                 string
                 string
                 bytes
                 (map string address)
                 (big_map nat (pair nat (map string bytes)))
                 (big_map nat nat)
                 (big_map (pair address nat) nat)
                 (big_map nat address)
                 nat)
           unit
           { CAR ;
             SENDER ;
             COMPARE ;
             NEQ ;
             IF { PUSH nat 15 ; FAILWITH } { UNIT } } ;
         LAMBDA
           (pair address
                 (big_map string bytes)
                 nat
                 nat
                 string
                 string
                 string
                 string
                 bytes
                 (map string address)
                 (big_map nat (pair nat (map string bytes)))
                 (big_map nat nat)
                 (big_map (pair address nat) nat)
                 (big_map nat address)
                 nat)
           unit
           { GET 19 ;
             SENDER ;
             PUSH bool False ;
             DIG 2 ;
             ITER { CDR ; DUP 3 ; COMPARE ; EQ ; IF { DROP ; PUSH bool True } {} } ;
             SWAP ;
             DROP ;
             IF {} { PUSH string "ONLY_WHITELISTED_CONTRACTS_ALLOWED" ; FAILWITH } ;
             UNIT } ;
         DIG 3 ;
         UNPAIR ;
         PUSH mumav 0 ;
         AMOUNT ;
         COMPARE ;
         EQ ;
         IF {} { PUSH nat 0 ; FAILWITH } ;
         IF_LEFT
           { IF_LEFT
               { DIG 3 ;
                 DROP ;
                 IF_LEFT
                   { SWAP ;
                     DUP ;
                     DIG 3 ;
                     SWAP ;
                     EXEC ;
                     DROP ;
                     DUP ;
                     GET 23 ;
                     DUP 3 ;
                     GET ;
                     IF_NONE
                       { PUSH string "TOTAL_SUPPLY_NOT_FOUND" ; FAILWITH }
                       { PUSH nat 1 ;
                         SWAP ;
                         COMPARE ;
                         EQ ;
                         IF {} { PUSH string "TOTAL_SUPPLY_IS_ZERO" ; FAILWITH } } ;
                     DUP ;
                     GET 27 ;
                     DUP 3 ;
                     GET ;
                     IF_NONE { PUSH string "TOKEN_HAS_NO_OWNER" ; FAILWITH } {} ;
                     DUP 2 ;
                     DIG 2 ;
                     GET 25 ;
                     PUSH nat 0 ;
                     DUP 5 ;
                     DIG 4 ;
                     PAIR ;
                     SWAP ;
                     SOME ;
                     SWAP ;
                     UPDATE ;
                     UPDATE 25 ;
                     DUP ;
                     GET 23 ;
                     PUSH nat 0 ;
                     DUP 4 ;
                     SWAP ;
                     SOME ;
                     SWAP ;
                     UPDATE ;
                     UPDATE 23 ;
                     DUP ;
                     GET 27 ;
                     PUSH address "mv2burnburnburnburnburnburnbur7hzNeg" ;
                     DIG 3 ;
                     SWAP ;
                     SOME ;
                     SWAP ;
                     UPDATE ;
                     UPDATE 27 }
                   { SWAP ;
                     DUP ;
                     DIG 3 ;
                     SWAP ;
                     EXEC ;
                     DROP ;
                     DUP ;
                     GET 28 ;
                     DUP 2 ;
                     GET 23 ;
                     DUP 2 ;
                     GET ;
                     IF_NONE
                       {}
                       { PUSH nat 0 ;
                         SWAP ;
                         COMPARE ;
                         EQ ;
                         IF {} { PUSH string "TOTAL_SUPPLY_EXCEEDS_ONE" ; FAILWITH } } ;
                     DUP 2 ;
                     DUP 3 ;
                     GET 21 ;
                     EMPTY_MAP string bytes ;
                     DIG 4 ;
                     GET 17 ;
                     SOME ;
                     PUSH string "" ;
                     UPDATE ;
                     DUP 4 ;
                     PAIR ;
                     DUP 4 ;
                     SWAP ;
                     SOME ;
                     SWAP ;
                     UPDATE ;
                     UPDATE 21 ;
                     SWAP ;
                     DUP 2 ;
                     DIG 2 ;
                     GET 25 ;
                     PUSH nat 1 ;
                     DUP 4 ;
                     DUP 6 ;
                     PAIR ;
                     SWAP ;
                     SOME ;
                     SWAP ;
                     UPDATE ;
                     UPDATE 25 ;
                     SWAP ;
                     DUP 2 ;
                     DIG 2 ;
                     GET 23 ;
                     PUSH nat 1 ;
                     DUP 4 ;
                     SWAP ;
                     SOME ;
                     SWAP ;
                     UPDATE ;
                     UPDATE 23 ;
                     SWAP ;
                     DUP 2 ;
                     DIG 2 ;
                     GET 27 ;
                     DIG 3 ;
                     DIG 3 ;
                     SWAP ;
                     SOME ;
                     SWAP ;
                     UPDATE ;
                     UPDATE 27 } }
               { IF_LEFT
                   { DIG 3 ;
                     DROP ;
                     SWAP ;
                     DUP ;
                     DIG 3 ;
                     SWAP ;
                     EXEC ;
                     DROP ;
                     DUP 2 ;
                     CAR ;
                     DUP 3 ;
                     GET 3 ;
                     DUP 3 ;
                     GET 23 ;
                     DUP 2 ;
                     GET ;
                     IF_NONE
                       {}
                       { PUSH nat 0 ;
                         SWAP ;
                         COMPARE ;
                         EQ ;
                         IF {} { PUSH string "TOTAL_SUPPLY_EXCEEDS_ONE" ; FAILWITH } } ;
                     DUP 3 ;
                     DIG 3 ;
                     GET 21 ;
                     EMPTY_MAP string bytes ;
                     DIG 5 ;
                     GET 4 ;
                     SOME ;
                     PUSH string "" ;
                     UPDATE ;
                     DUP 4 ;
                     PAIR ;
                     DUP 4 ;
                     SWAP ;
                     SOME ;
                     SWAP ;
                     UPDATE ;
                     UPDATE 21 ;
                     DUG 2 ;
                     DUP 3 ;
                     DIG 3 ;
                     GET 25 ;
                     PUSH nat 1 ;
                     DUP 4 ;
                     DUP 6 ;
                     PAIR ;
                     SWAP ;
                     SOME ;
                     SWAP ;
                     UPDATE ;
                     UPDATE 25 ;
                     DUG 2 ;
                     DUP 3 ;
                     DIG 3 ;
                     GET 23 ;
                     PUSH nat 1 ;
                     DUP 4 ;
                     SWAP ;
                     SOME ;
                     SWAP ;
                     UPDATE ;
                     UPDATE 23 ;
                     DUG 2 ;
                     DUP 3 ;
                     DIG 3 ;
                     GET 27 ;
                     DIG 3 ;
                     DIG 3 ;
                     SWAP ;
                     SOME ;
                     SWAP ;
                     UPDATE ;
                     UPDATE 27 }
                   { DIG 2 ; DROP ; SWAP ; DUP ; DIG 3 ; SWAP ; EXEC ; DROP ; SWAP ; UPDATE 1 } } }
           { DIG 2 ;
             DROP ;
             SWAP ;
             DUP ;
             DIG 3 ;
             SWAP ;
             EXEC ;
             DROP ;
             DUP ;
             GET 19 ;
             DIG 2 ;
             SWAP ;
             DUP 2 ;
             CAR ;
             DUP 3 ;
             GET 4 ;
             IF_LEFT
               { DIG 3 ; DROP 2 ; SWAP ; NONE address ; DIG 2 ; UPDATE }
               { DROP ; SWAP ; DIG 2 ; GET 3 ; SOME ; DIG 2 ; UPDATE } ;
             UPDATE 19 } ;
         SWAP ;
         PAIR } ;
  view "getAdmin" unit address { CDR ; CAR } ;
  view "maxSupply" unit nat { CDR ; GET 5 } ;
  view "percentageInterest" unit nat { CDR ; GET 7 } ;
  view "description" unit string { CDR ; GET 9 } ;
  view "location" unit string { CDR ; GET 11 } ;
  view "value" unit string { CDR ; GET 13 } ;
  view "other" unit string { CDR ; GET 15 } ;
  view "getWhitelistContracts" unit (map string address) { CDR ; GET 19 } ;
  view "get_balance"
       (pair (address %owner) (nat %token_id))
       nat
       { UNPAIR ; SWAP ; GET 25 ; SWAP ; GET ; IF_NONE { PUSH nat 0 } {} } ;
  view "owner_of" nat (option address) { UNPAIR ; SWAP ; GET 27 ; SWAP ; GET } ;
  view "next_token_id" unit nat { CDR ; GET 28 } ;
  view "total_supply"
       nat
       nat
       { UNPAIR ; SWAP ; GET 23 ; SWAP ; GET ; IF_NONE { PUSH nat 0 } {} } ;
  view "token_metadata"
       nat
       (pair (nat %token_id) (map %token_info string bytes))
       { UNPAIR ;
         SWAP ;
         GET 21 ;
         DUP 2 ;
         GET ;
         IF_NONE { EMPTY_MAP string bytes ; SWAP ; PAIR } { SWAP ; DROP } } }

